# API key for the Annuaire Sante FHIR API (required)
# Obtain your key at: https://portal.api.esante.gouv.fr
ESANTE_API_KEY=your_api_key_here

# Optional: override the base URL of the FHIR API
# FHIR_BASE_URL=https://gateway.api.esante.gouv.fr/fhir/v2

# Optional: HTTP request timeout in seconds (default: 30)
# HTTP_TIMEOUT=30

# Optional: maximum number of results per request (default: 50)
# MAX_RESULTS=50

# Optional: transport mode — stdio (default) or http
# MCP_TRANSPORT=stdio
# MCP_HOST=127.0.0.1
# MCP_PORT=8000
